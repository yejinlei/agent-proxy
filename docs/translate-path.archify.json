  "cards": [
    {
      "dot": "emerald",
      "title": "Invariants",
      "items": [
        "消息格式转换始终先于流 / 非流决策",
        "InternalRequest.Stream 在 TranslateRequest 阶段捕获并保留至最终 handler",
        "system 抽到 InternalRequest.SystemPrompt，绝不留在 Messages 里"
      ]
    },
    {
      "dot": "rose",
      "title": "Passthrough shortcut",
      "items": [
        "当入站协议属于上游能力时，跳过翻译",
        "只解析模型别名；请求体原样转发",
        "自适应流包装 / 拆包让透传客户端毫无察觉"
      ]
    },
    {
      "dot": "amber",
      "title": "SSE teardown",
      "items": [
        "每个协议执行完整事件生命周期",
        "取消安全：通道提前关闭也发完收尾事件",
        "Claude Code 与 Codex 严格校验这些序列"
      ]
    }
  ]
