  "cards": [
    {
      "dot": "emerald",
      "title": "同协议两种传输",
      "items": [
        "入站协议识别完全相同：ingress=responses，翻译与上游调用两路一致",
        "不假设 Codex 用哪种传输，来什么处理什么",
        "只有出站封装不同，事件序列逐字节相同"
      ]
    },
    {
      "dot": "cyan",
      "title": "无握手路径",
      "items": [
        "handleResponses 里 Upgrade 头缺失即走 handleRequest",
        "省掉 SHA-1 握手与帧编解码，直接复用 HTTP 长连接",
        "WriteTimeout 默认 600s 管这条 SSE 长连接"
      ]
    },
    {
      "dot": "rose",
      "title": "事件序列不变",
      "items": [
        "WriteHeader(200) 加 Flush 才能开 chunked，WS 靠帧边界 SSE 靠空行",
        "SSE 下每条事件仍是 data: 前缀加单行 JSON",
        "[DONE] 必须紧跟 response.completed 之后，不可反序"
      ]
    }
  ]
}