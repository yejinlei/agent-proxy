  "cards": [
    {
      "dot": "emerald",
      "title": "事件序列硬约束",
      "items": [
        "message_start → content_block_start → content_block_delta* → content_block_stop → message_delta → message_stop",
        "message_start.content 必须是 [] 而非 null，id 必须 msg_ 前缀非空",
        "content_block_start 必须带 citations: []，且先于第一个 delta"
      ]
    },
    {
      "dot": "amber",
      "title": "Token 计数",
      "items": [
        "message_start.output_tokens 必须为 0，最终数写在 message_delta",
        "usage 恒为非空对象，Claude Code 校验 K.usage.input_tokens",
        "CC SSE 请求必须注入 stream_options:{include_usage:true}"
      ]
    },
    {
      "dot": "rose",
      "title": "取消安全与工具配对",
      "items": [
        "流被取消也补发 content_block_stop 加 message_delta 加 message_stop",
        "buildCCRequest 为 role:tool 消息配对 tool_call_id，否则模型误判文件未读",
        "thinking 块在出口剥离，非流式与流式两路都要过滤"
      ]
    }
  ]
}