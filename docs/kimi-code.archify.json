  "cards": [
    {
      "dot": "rose",
      "title": "触发条件",
      "items": [
        "必须同时满足 stream: true 与请求体 > 100 KB 阈值",
        "Kimi 系统提示词约 50407 字符，首轮 body 已 125997 B，必中阈值",
        "续轮 body 涨到 135894 / 136275 B，阈值不会因续轮被绕过"
      ]
    },
    {
      "dot": "emerald",
      "title": "v0.2.129 修复",
      "items": [
        "修复前 delta 只搬 role 与 content，message.tool_calls 整段丢弃",
        "客户端收到 finish_reason: tool_calls 却配空工具列表，Kimi 直接结束步骤",
        "现按白名单重建 delta，补 index 与 type: function，不整包塞 message"
      ]
    },
    {
      "dot": "cyan",
      "title": "工具回灌与遗留",
      "items": [
        "回灌的 role:tool 消息必须带 tool_call_id 才能配对",
        "上游 reasoning 等非标准字段若整包透传会被严格客户端拒收",
        "遗留：这条 SSE 包装不透出 usage，Kimi 侧 usage.record 显示全 0"
      ]
    }
  ]
