# Database
*.db
*.db-journal
~/.agent-proxy/

# IDE
.vscode/
.idea/

# Env (keep .env.example, ignore actual .env)
.env

# ── Binaries & compiled artifacts (released via GitHub Releases) ──
# Go build outputs
*.exe
/agent-proxy
/agent-proxy.exe
/server
/server.exe

# OS-specific binaries (no extension)
/agent-proxy-darwin-*
/agent-proxy-linux-*
/agent-proxy-windows-*

# Shared libraries
*.dll
*.so
*.dylib

# Generic binary patterns
*.bin

# ── Release & packaging ──
# Release directories
_release/
_release_v*/
dist/

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.bundle

# Release metadata (generated)
release_body.json

# ── Temp & test files ──
.tmp/
test-request.json
test-stream.json
